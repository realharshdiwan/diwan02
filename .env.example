# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Resend email dispatch for /api/apply cohort submissions:
# Add RESEND_API_KEY in AI Studio Secrets (or local .env).
# Leave RESEND_FROM_EMAIL unset to use the Resend test sender
# (onboarding@resend.dev). In that mode Resend only delivers to the email
# address on your Resend account, so set APPLICATION_NOTIFY_EMAIL to that
# address while testing.
# Verify diwanmercantile.in in Resend before setting RESEND_FROM_EMAIL to a
# careers@diwanmercantile.in address or sending applicant confirmations.
RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Diwan Mercantile <careers@diwanmercantile.in>"
APPLICATION_NOTIFY_EMAIL="diwanmercantileindia@gmail.com"

# Optional external webhook (e.g. Google Apps Script -> Google Sheet) for /api/apply:
# APPLICATION_WEBHOOK_URL=""

# Optional secret key to enable GET /api/applications (?format=csv supported):
# APPLICATION_ADMIN_KEY=""
