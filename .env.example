# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase (PostgreSQL + Magic-Link Auth for /studio, /research, and /careers):
# Add these in Vercel Project Settings -> Environment Variables (or AI Studio Secrets / .env).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Vite-prefixed mirrors (automatically read if set; otherwise fetched from /api/studio/config):
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY=""

# Comma-separated emails allowed to sign into /studio (defaults to founder email):
STUDIO_ALLOWED_EMAILS="diwanharsh33@gmail.com,diwanmercantileindia@gmail.com"

# Resend email dispatch for /api/apply cohort submissions:
# In sandbox mode (without RESEND_FROM_EMAIL), Resend only delivers to your Resend account owner email.
# Verify diwanmercantile.in in Resend and set RESEND_FROM_EMAIL to notify team addresses and send applicant confirmations.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Diwan Mercantile <careers@diwanmercantile.in>"
APPLICATION_NOTIFY_EMAIL="diwanmercantileindia@gmail.com"

# Optional external webhook (e.g. Google Apps Script -> Google Sheet) for /api/apply:
# APPLICATION_WEBHOOK_URL=""

# Optional secret key for headless GET /api/applications (?format=csv supported):
# APPLICATION_ADMIN_KEY=""
